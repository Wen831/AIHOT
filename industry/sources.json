{
  "$comment": "示范信源：首次启动时导入（scripts/seed.ts），已存在的不会被覆盖。之后在后台“信源”里增删改。字段说明见 docs/customize.md。足球起步配置：直播吧足球频道 + 懂球帝首页，均为 web_list 直抓（两站列表与详情页都是 SSR，2026-10-02 实测验证）；interval 1380 分钟配合 COLLECT_SCHEDULE_CRON=0 5 * * * 实现每天 5 点批量采集。",
  "sources": [
    {
      "id": "web-zhibo8-zuqiu",
      "name": "直播吧足球",
      "kind": "web_list",
      "config": {
        "url": "https://news.zhibo8.com/zuqiu/",
        "parseMode": "html",
        "itemSelector": "li",
        "titleSelector": "a",
        "publishedAtRegex": "zhibo8\\.com/zuqiu/(\\d{4}-\\d{2}-\\d{2})/",
        "allowUrlPrefixes": ["https://news.zhibo8.com/zuqiu/"],
        "_aihot": {
          "initialBackfillLimit": 10,
          "maxAgeDays": 3
        }
      },
      "tier": "T1_5",
      "first_party": false,
      "participation_mode": "editorial",
      "interval_minutes": 1380,
      "tags": ["足球媒体"],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "web-dongqiudi-home",
      "name": "懂球帝",
      "kind": "web_list",
      "config": {
        "url": "https://www.dongqiudi.com/",
        "parseMode": "html",
        "itemSelector": "a.news-card",
        "titleSelector": ".news-card__title",
        "allowUrlPrefixes": ["https://www.dongqiudi.com/articles/"],
        "_aihot": {
          "initialBackfillLimit": 10,
          "maxAgeDays": 3
        }
      },
      "tier": "T1_5",
      "first_party": false,
      "participation_mode": "editorial",
      "interval_minutes": 1380,
      "tags": ["足球媒体"],
      "site_fulltext": false,
      "syndicate_fulltext": false
    }
  ]
}
